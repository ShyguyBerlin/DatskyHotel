			visible = angle >= norm_start || angle <= (end_angle - 6.28318);
		}
	} else {
		float end_angle = norm_start - arc_length;
		if (end_angle >= 0.0) {
			// No wraparound
			visible = angle <= norm_start && angle >= end_angle;
		} else {
			// Wraparound case
			visible = angle <= norm_start || angle >= (end_angle + 6.28318);
